% cards.sty -- shared preamble for the A5 reference cards (make cards).
%
% A5 portrait, duplex. The inner margin clears ISO 838 punch holes (12 mm
% from the edge, 6 mm wide), so each card is one sheet in a binder. Print
% duplex on A5, or 2-up on A4 and cut once.
%
% Deck cards use \cardfront{Name} / \cardback{Name}: the front lands on a
% recto page and the back on its verso. Topic cards use \cardtitle{Name}
% and flow over as many pages as they need. Every page carries the card
% name in the footer, since binder pages come loose.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cards}[2026/10/11 A5 reference cards]

\RequirePackage[a5paper,twoside,inner=20mm,outer=10mm,top=10mm,bottom=13mm,footskip=7mm]{geometry}
\RequirePackage{multicol}
\RequirePackage{tabularx}
\RequirePackage{needspace}
\RequirePackage{fancyhdr}
\RequirePackage{amssymb}
\RequirePackage[T1]{fontenc}
\RequirePackage{microtype}
\RequirePackage{helvet}
\RequirePackage[scaled=0.82]{beramono}
\renewcommand{\familydefault}{\sfdefault}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\columnsep}{5mm}
\setlength{\tabcolsep}{0pt}
\raggedbottom

% Footer: card name on the outer edge, page number in the centre.
\newcommand{\cards@name}{}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[LE,RO]{\footnotesize\itshape\cards@name}
\fancyfoot[C]{\footnotesize\thepage}

% Start on a recto page; a filler verso, if one is needed, stays blank.
\newcommand{\cards@recto}{%
  \clearpage
  \ifodd\value{page}\else\hbox{}\thispagestyle{empty}\clearpage\fi}

\newcommand{\cards@head}[2]{%
  {\Large\bfseries #1}\hfill{\small\itshape #2}\\[-1pt]
  \rule{\linewidth}{0.4pt}\par\vspace{4pt}}

\newcommand{\cardtitle}[1]{%
  \renewcommand{\cards@name}{#1}%
  \cards@head{#1}{}}
\newcommand{\cardfront}[1]{%
  \cards@recto
  \renewcommand{\cards@name}{#1 \textperiodcentered\ front}%
  \cards@head{#1}{front}}
\newcommand{\cardback}[1]{%
  \clearpage
  \renewcommand{\cards@name}{#1 \textperiodcentered\ back}%
  \cards@head{#1}{back}}

% One line of facts under a title (prefix key, leader, options in force).
\newcommand{\facts}[1]{{\scriptsize #1}\par\vspace{3pt}}

% Section header, kept off the foot of a column.
\newcommand{\sect}[1]{%
  \needspace{4\baselineskip}\vspace{5pt}%
  {\footnotesize\bfseries\scshape #1}\par\vspace{2pt}}

% Key / action table: monospace key, wrapping description.
\newenvironment{keys}{\tabularx{\linewidth}{@{}l@{\enspace}Y@{}}}{\endtabularx\par}

% Small-print remark after a table.
\newcommand{\cardnote}[1]{{\scriptsize #1}\par}

% Long command with its description underneath. A key wider than about
% 22 characters would squeeze every description in its keys table, so
% such commands go here instead.
\newcommand{\cmd}[2]{%
  {\raggedright\texttt{#1}\par}%
  {\hspace*{1.5em}\footnotesize #2\par}}
