# shellcheck shell=bash
# ------------------
# Shared environment for login shells (sourced by .zprofile and .bash_profile)
# ------------------

# Homebrew
export HOMEBREW_AUTO_UPDATE_SECS=86400
export HOMEBREW_NO_ENV_HINTS=1
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# ------------------
# PATH
# ------------------
export PATH="$HOME/.local/bin:$PATH"

# ------------------
# Rust
# ------------------
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# ------------------
# JavaScript
# ------------------
export NVM_DIR="$HOME/.nvm"

# ------------------
# bat
# ------------------
export BAT_THEME="ansi"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# ------------------
# macOS-specific
# ------------------
# $OSTYPE (set by bash and zsh) instead of $(uname): every subprocess here runs
# for each new shell/tmux pane, and endpoint security makes each one costly.
case "$OSTYPE" in
  darwin*)
    if _java_home=$(/usr/libexec/java_home 2>/dev/null); then
      export JAVA_HOME="$_java_home"
    fi
    unset _java_home
    [ -d /Library/TeX/texbin ] && export PATH="/Library/TeX/texbin:$PATH"
    ;;
esac
