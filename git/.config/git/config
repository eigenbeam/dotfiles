[user]
	name = Kevin W. Beam
	# email set per-machine in ~/.gitconfig-local
[color]
	ui = auto
[apply]
	whitespace = nowarn
[core]
	autocrlf = input
	safecrlf = false
	pager = delta
	excludesFile = ~/.config/git/ignore
	untrackedCache = true
	# fsmonitor is deliberately not global: in small repos it makes `git status`
	# slower (it spawns a daemon on first use). Enable per-repo for huge ones:
	#   git config core.fsmonitor true
	# Uncomment to use global hooks (overrides per-repo hooks):
	# hooksPath = ~/.config/git/hooks
[alias]
	st = status
	sts = status --short
	hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
	co = checkout
	br = branch
	ci = commit
	unstage = restore --staged
	amend = commit --amend --no-edit
	undo = reset --soft HEAD~1
	prev = switch -
[push]
	default = simple
	followTags = true
[pull]
	rebase = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	autoSquash = true
[rerere]
	enabled = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# Credential helper is machine-specific; set in ~/.gitconfig-local
# macOS: [credential] helper = osxkeychain
# Linux: [credential] helper = cache  (or store, or /usr/lib/git-core/git-credential-libsecret)
[github]
	user = eigenbeam
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = ansi
	file-style = bold
	# Light-only for now. For auto light/dark later, delete this line: delta 0.20
	# detects the terminal background (detect-dark-light = auto).
	light = true
[diff]
	colorMoved = default
	algorithm = histogram
[merge]
	conflictStyle = zdiff3
[init]
	defaultBranch = main

# Machine-specific overrides (e.g., work email, git-secrets)
[include]
	path = ~/.gitconfig-local

# Directory-based overrides (uncomment and adjust for per-repo-directory config)
# [includeIf "gitdir:~/work/"]
